# ==============================================================================
# Sentinelbit - Konfigurationsvorlage (.env)
# ==============================================================================

# Port, auf dem der HTTP-Dienst lauscht (Standard: 8000)
SENTINELBIT_PORT=8000

# Netzwerkadresse für Bind (Standard: 0.0.0.0; für rein lokalen Zugriff: 127.0.0.1)
SENTINELBIT_HOST=0.0.0.0

# Datenverzeichnis für SQLite-Datenbank, Backups und Serverschlüssel
# Standard: ./data (wird automatisch angelegt)
SENTINELBIT_DATA_DIR=./data

# Offene Registrierung neuer Benutzer deaktivieren (true / false)
# Empfohlen bei Freigabe über das öffentliche Internet
SENTINELBIT_DISABLE_REGISTRATION=false

# Log-Level: debug, info, warn, error (Standard: info)
SENTINELBIT_LOG_LEVEL=info
